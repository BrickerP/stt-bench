# STT Bench — copy to .env and fill in values. Never commit .env.

# OpenAI (Whisper batch)
OPENAI_API_KEY=sk-...

# Deepgram (streaming)
DEEPGRAM_API_KEY=...

# AssemblyAI (batch) — optional
ASSEMBLYAI_API_KEY=...

# Google Cloud Speech-to-Text (batch). Service account JSON path.
# speech:recognize uses OAuth, not an API key. Do not commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Speech (batch fast transcription)
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# Server
STT_BENCH_HOST=127.0.0.1
STT_BENCH_PORT=8766
STT_BENCH_DB_PATH=./data/results.db
STT_BENCH_CACHE_DIR=./data/cache

# Rate limits (requests per minute per provider)
WHISPER_RPM=50
DEEPGRAM_RPM=100

# Default provider configs (override per run)
WHISPER_MODEL=whisper-1
DEEPGRAM_MODEL=nova-2
ASSEMBLYAI_MODEL=best
GOOGLE_SPEECH_MODEL=latest_long
AZURE_SPEECH_MODEL=fast

# Logging
STT_BENCH_LOG_LEVEL=INFO
